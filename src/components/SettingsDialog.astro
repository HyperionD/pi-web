---
import { X } from "@lucide/astro";
import { UI_LOCALES } from "../i18n/locales";
import { SETTINGS_FIELDS as settingsFields } from "../pi-app/workspace/settings-schema";

const settingsFieldByPath = Object.fromEntries(settingsFields.map((field) => [field.path, field]));
const settingsGroups = [
  {
    title: "Model",
    titleKey: "model",
    description: "provider, model, thinking",
    descriptionKey: "modelDescription",
    paths: ["defaultProvider", "defaultModel"],
  },
  {
    title: "Conversation",
    titleKey: "conversation",
    description: "prompt flow and transcript behavior",
    descriptionKey: "conversationDescription",
    paths: ["compaction.enabled", "enableSkillCommands", "steeringMode", "followUpMode", "hideThinkingBlock"],
  },
  {
    title: "Warnings",
    titleKey: "warnings",
    description: "usage and safety notices",
    descriptionKey: "warningsDescription",
    paths: ["warnings.anthropicExtraUsage"],
  },
].map((group) => ({ ...group, fields: group.paths.map((path) => settingsFieldByPath[path]).filter(Boolean) }));
---

  <div class="settings-modal" data-settings-modal hidden>
    <form class="settings-dialog" data-settings-form role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1">
      <div class="settings-head">
        <div><strong id="settings-title" data-i18n="settingsTitle">pi settings</strong><small data-i18n="settingsSubtitle">same files used by settings command</small></div>
        <button type="button" data-action="close-settings" aria-label="close settings" data-i18n-aria-label="closeSettings"><X size={14} strokeWidth={1.75} aria-hidden="true" /></button>
      </div>
      <div class="settings-body">
        <div class="settings-language-row">
          <label><span data-i18n="language">Language</span>
            <select name="uiLanguage" data-ui-language>
              {UI_LOCALES.map((locale) => <option value={locale.code}>{locale.label}</option>)}
            </select>
          </label>
          <small data-i18n="languageHint">Changes apply immediately and are saved on this device.</small>
        </div>
        <section class="settings-group settings-model-group" aria-label="我的默认模型">
          <div class="settings-group-head"><div><strong>我的默认模型</strong><small>从 Pi 当前可用模型中选择，适用于所有工作区</small></div></div>
          <div class="settings-grid">
            <label class="settings-field"><span>模型</span>
              <select data-account-model disabled><option value="inherit">使用管理员默认</option></select>
              <small data-account-model-status aria-live="polite">正在加载 Pi 可用模型…</small>
            </label>
            <label class="settings-field"><span>思考级别</span>
              <select data-setting="defaultThinkingLevel">
                <option value="inherit">使用管理员默认</option>
                {settingsFieldByPath.defaultThinkingLevel.values.map((value) => <option value={value}>{value}</option>)}
              </select><small>账号默认思考级别</small>
            </label>
          </div>
          <button type="button" data-action="apply-session-model">应用到当前会话</button>
          <button type="button" data-action="reset-account-model">恢复管理员默认</button>
        </section>
        <details class="settings-advanced" data-settings-shared-only>
          <summary>管理员高级设置</summary>
          <small data-model-catalog-info>Pi 可用模型来自当前运行环境；models.json 可选</small>
        <div class="settings-toolbar">
          <label><span data-i18n="scope">scope</span>
            <select name="scope" data-settings-scope>
              <option value="project" data-i18n="project">project</option>
              <option value="global" data-i18n="global">global</option>
              <option value="personal">个人</option>
            </select>
          </label>
          <label data-settings-location-wrap hidden>位置
            <select name="location" data-settings-location>
              <option value="project">当前工作区</option>
              <option value="global">所有工作区</option>
            </select>
          </label>
          <span data-settings-path>—</span>
        </div>
        <section class="app-settings-section" data-settings-shared-only aria-labelledby="app-settings-title">
          <div class="app-settings-head">
            <div>
              <strong id="app-settings-title">pi-web 应用设置</strong>
              <small>用户级配置，不随 project / global scope 切换</small>
            </div>
            <small class="app-settings-path">path: <code data-app-config-path>—</code></small>
          </div>
          <label class="settings-field app-settings-upload-limit">
            <span>单文件上传上限（MiB）</span>
            <input data-app-setting="max-upload-mib" type="number" min="1" max="2048" step="1" inputmode="numeric" autocomplete="off" aria-describedby="max-upload-mib-hint" />
            <small id="max-upload-mib-hint">MiB；1–2048，保存后立即生效</small>
          </label>
          <label class="settings-field">
            <span>品牌</span>
            <input data-app-setting="brand" autocomplete="off" placeholder="pi.dev / web" />
          </label>
          <div class="allowed-roots-settings">
            <div class="allowed-roots-head">
              <div>
                <strong>工作区允许目录</strong>
                <small>限制工作区文件访问；不填写表示不限制。</small>
              </div>
              <button type="button" data-allowed-root-add aria-haspopup="dialog" aria-expanded="false">添加目录</button>
            </div>
            <textarea data-app-setting="allowed-roots" hidden aria-hidden="true"></textarea>
            <div class="allowed-roots-list" data-allowed-roots-list></div>
            <small class="allowed-roots-hint" data-allowed-roots-hint>不限制工作区目录</small>
          </div>
        </section>
        <details class="auth-login" data-auth-form data-settings-shared-only>
          <summary>
            <span class="auth-login-title"><span data-i18n="authTitle">Authentication</span> <em data-i18n="authMode">API key login</em></span>
            <small data-auth-status>API key is stored in ~/.pi/agent/auth.json</small>
          </summary>
          <div class="auth-login-fields">
            <label><span data-i18n="provider">provider</span>
              <select data-auth-provider>
                <option value="">loading providers…</option>
              </select>
            </label>
            <label><span data-i18n="apiKey">API key</span>
              <input data-auth-api-key type="password" autocomplete="off" placeholder="paste API key" data-i18n-placeholder="pasteApiKey" />
            </label>
            <div class="auth-login-actions">
              <button type="button" data-action="save-auth-provider" data-i18n="saveKey">save key</button>
              <button type="button" data-action="logout-auth-provider" data-i18n="logout">logout</button>
            </div>
          </div>
          <div class="oauth-login-fields" data-oauth-fields hidden>
            <label><span data-i18n="oauthProvider">OAuth provider</span>
              <select data-oauth-provider>
                <option value="" data-i18n="loadingOAuthProviders">loading OAuth providers…</option>
              </select>
            </label>
            <button type="button" data-action="start-oauth-login" data-i18n="loginWithOAuth">login with OAuth</button>
            <a data-oauth-link href="#" target="_blank" rel="noreferrer" hidden data-i18n="openLoginPage">open login page</a>
            <input data-oauth-input autocomplete="off" placeholder="prompt input or redirect URL" data-i18n-placeholder="oauthInput" hidden />
            <button type="button" data-action="send-oauth-input" hidden data-i18n="send">send</button>
            <small data-oauth-status>OAuth supports Claude, Codex, and Copilot subscriptions.</small>
          </div>
        </details>
        <div class="settings-groups">
          {settingsGroups.map((group) => (
            <section class:list={["settings-group", group.titleKey === "model" ? "settings-model-group" : "settings-non-model-group"]} hidden={group.titleKey === "model"} data-settings-shared-only={true}>
              <div class="settings-group-head">
                <div>
                  <strong data-i18n={group.titleKey}>{group.title}</strong>
                  <small data-i18n={group.descriptionKey}>{group.description}</small>
                </div>
              </div>
              <div class="settings-grid">
                {group.fields.map((field) => (
                  <label
                    class="settings-field"
                  >
                    <span>{field.label}</span>
                      {field.type === "text" ? (
                      <input data-setting={field.path} autocomplete="off" placeholder={field.hint} />
                    ) : field.type === "password" ? (
                      <input data-setting={field.path} type="password" autocomplete="off" placeholder={field.hint} />
                    ) : field.type === "providerSelect" || field.type === "modelSelect" ? (
                      <>
                        <select data-setting={field.path} disabled>
                          <option value="inherit">loading models…</option>
                        </select>
                        <input data-custom-setting={field.path} autocomplete="off" placeholder={`custom ${field.label}`} hidden />
                      </>
                    ) : field.type === "boolean" ? (
                      <select data-setting={field.path}>
                        <option value="inherit">inherit</option>
                        <option value="true">on</option>
                        <option value="false">off</option>
                      </select>
                    ) : field.type === "checkbox" ? (
                      <span class="settings-checkbox"><input type="checkbox" data-setting={field.path} /> <span data-i18n="enabled">Enabled</span></span>
                    ) : (
                      <select data-setting={field.path}>
                        <option value="inherit">inherit</option>
                        {field.values.map((value) => <option value={value}>{value}</option>)}
                      </select>
                    )}
                    <small>effective: not set</small>
                  </label>
                ))}
              </div>
            </section>
          ))}
        </div>
        </details>
      </div>
      <div class="settings-foot">
        <span data-settings-status>blank fields inherit from effective settings</span>
        <button type="button" data-action="close-settings" data-i18n="cancel">cancel</button>
        <button type="submit" data-i18n="save">save</button>
      </div>
    </form>
  </div>
