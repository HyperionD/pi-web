---
import {
  ArrowDown,
  ChevronLeft,
  ChevronRight,
  Folder,
  GitBranch,
  Menu,
  Paperclip,
  Plus,
  RefreshCw,
  SendHorizontal,
  Settings,
  Square,
  X,
} from "@lucide/astro";
import WorkspaceFileTree from "./components/WorkspaceFileTree";
import { UI_LOCALES } from "./i18n/locales";
import { escapeHtml, renderBannerBody, renderPiBody, renderUserBody } from "./lib/renderers";
import { formatToolArgs, toolIconHtml } from "./pi-app/messages/tool-message-methods";
import { isLargeToolBody, renderToolBody } from "./pi-app/messages/tool-output-rendering";
import { PI_WEB_WELCOME_TEXT, TERMINAL_SPINNER_HTML } from "./pi-app/constants";
import { SETTINGS_FIELDS as settingsFields } from "./pi-app/workspace/settings-schema";

const {
  initialSession = "active",
  treeOpen = true,
  sidebarCollapsed = false,
  showCompaction = false,
  showDisconnect = false,
  scanlines = false,
  workspaces = [],
  fileTree = [],
  conversation = [],
  slashCommands = [],
} = Astro.props;

const activeWorkspace = workspaces[0];
const activeSession = activeWorkspace?.sessions?.[0];
const activeWorkspaceName = activeWorkspace?.name || "工作区";
const activeSessionTitle = activeSession?.title || "无会话";
const activeSessionID = activeSession?.id || "";
const activeWorkspaceID = activeWorkspace?.id || "";
const emptyVisible = initialSession === "empty";
const sessionVisible = !emptyVisible;
const bodyClass = "app-body";
const bodyGrid = sidebarCollapsed ? "1fr" : "280px 1fr";
const sessionHidden = !sessionVisible;
const emptyHidden = !emptyVisible;
const compactionHidden = !showCompaction;
const settingsFieldByPath = Object.fromEntries(settingsFields.map((field) => [field.path, field]));
const settingsGroups = [
  {
    title: "Model",
    titleKey: "model",
    description: "provider, model, thinking",
    descriptionKey: "modelDescription",
    paths: ["defaultProvider", "defaultModel", "defaultThinkingLevel"],
  },
  {
    title: "Conversation",
    titleKey: "conversation",
    description: "prompt flow and transcript behavior",
    descriptionKey: "conversationDescription",
    paths: ["compaction.enabled", "enableSkillCommands", "steeringMode", "followUpMode", "hideThinkingBlock"],
  },
  {
    title: "Warnings",
    titleKey: "warnings",
    description: "usage and safety notices",
    descriptionKey: "warningsDescription",
    paths: ["warnings.anthropicExtraUsage"],
  },
].map((group) => ({ ...group, fields: group.paths.map((path) => settingsFieldByPath[path]).filter(Boolean) }));
const treeHidden = !treeOpen;
const statusColor = showDisconnect ? "var(--danger)" : "var(--fg-3)";
const statusTitle = showDisconnect ? "已断开连接" : "连接中";

function toolStatus(msg) {
  if (msg.status === "running") return `${TERMINAL_SPINNER_HTML}<span style="color:var(--accent)">running</span>`;
  if (msg.status === "err") return `<span class="err">✗</span>${escapeHtml(msg.resultMeta || "failed")}`;
  return `<span class="ok">✓</span>${msg.durationMs ? `${msg.durationMs} ms` : ""}${msg.resultMeta ? ` · ${escapeHtml(msg.resultMeta)}` : ""}`;
}

---

<pi-app class="app" data-route="workspace" data-tree={treeOpen ? "on" : "off"} data-sidebar={sidebarCollapsed ? "collapsed" : "open"} data-session={initialSession} data-active-session-id={activeSessionID} data-active-workspace-id={activeWorkspaceID}>
  <header class="topbar">
    <button class="sb-expand-btn" type="button" data-action="expand-sidebar" aria-label="显示侧栏" style={sidebarCollapsed ? "display:inline-flex" : "display:none"}><ChevronRight size={16} strokeWidth={1.75} aria-hidden="true" /></button>
    <button class="hamburger" type="button" data-action="open-drawer" aria-label="打开侧栏"><Menu size={16} strokeWidth={1.75} aria-hidden="true" /></button>
    <span class="brand" aria-label="pi.dev / web">
      <span data-brand>pi.dev / web</span><span class="cursor-block"></span>
    </span>
    <span class="crumb">
      <span class="sep">/</span><span class="ws" data-active-workspace>{activeWorkspaceName}</span>
      <span class="sep">/</span><span class="session" data-active-session-title title={`${activeSessionTitle} · ${activeSessionID}`}>{activeSessionTitle}</span>
    </span>
    <div class="actions">
      <span class="iconbtn statusbtn" style={`color:${statusColor}`} title={statusTitle}>●</span>
    </div>
  </header>

  <div class="folder-popover" data-folder-popover role="dialog" aria-label="选择工作区" hidden>
    <div class="folder-popover-head">
      <strong>选择工作区</strong>
      <button type="button" data-action="folder-close" aria-label="关闭目录选择器">×</button>
    </div>
    <div class="folder-browser" data-folder-browser>
      <div class="folder-list" data-folder-list role="tree" aria-label="文件夹列表"></div>
      <span class="folder-loading" data-folder-loading hidden aria-live="polite">加载中…</span>
      <button type="button" class="folder-confirm" data-action="folder-open-current">选择此文件夹</button>
    </div>
  </div>

  <section class={bodyClass} data-view="workspace" style={`grid-template-columns:${bodyGrid}`}>
    <div class="sidebar-wrap" hidden={sidebarCollapsed}>
      <aside class="sidebar" aria-label="工作区和会话">
        <div class="sb-section" style="flex:1;overflow-y:auto;min-height:0">
          <div class="sb-head"><span>工作区</span><span class="sb-head-actions"><button class="add" type="button" data-action="route-picker" aria-haspopup="dialog" aria-expanded="false"><Plus size={12} strokeWidth={1.75} aria-hidden="true" /> 打开</button><button class="refresh" type="button" data-action="refresh-workspaces" title="刷新工作区" aria-label="刷新工作区"><RefreshCw size={12} strokeWidth={1.75} aria-hidden="true" /></button><button class="sb-collapse" type="button" data-action="collapse-sidebar" title="收起侧栏" aria-label="收起侧栏"><ChevronLeft size={14} strokeWidth={1.75} aria-hidden="true" /></button></span></div>
          {workspaces.map((workspace) => {
            const isActiveWorkspace = workspace.id === activeWorkspaceID;
            return (
              <div class="workspace-group" data-workspace-group={workspace.id}>
                <button type="button" class:list={["ws-row", isActiveWorkspace && "open"]} data-action="toggle-workspace" data-workspace={workspace.id} aria-expanded={isActiveWorkspace ? "true" : "false"}>
                  <span class="ws-stack"><span class="ws-name"><span class:list={["dot", workspace.live && "live"]}></span><span class="label">{workspace.name}</span></span><span class="ws-path">{workspace.path}</span></span>
                  <span class="ws-meta">{workspace.sessionCount}</span>
                </button>
                <div class="sessions" hidden={!isActiveWorkspace}>
                  {(workspace.sessions || []).map((session) => (
                    <button type="button" class:list={[
                      "session-row",
                      isActiveWorkspace && session.id === activeSessionID && "selected",
                      (session.active || session.live) && "active",
                    ]} data-session={session.id} data-workspace={workspace.id} data-title={session.title}>
                      <span class="title">{session.title}</span><span class:list={["meta", (session.active || session.live) && "live"]} hidden={!(session.active || session.live)}>{session.active || session.live ? "等待中" : ""}</span>
                    </button>
                  ))}
                  {(workspace.sessions || []).length === 0 && <div style="padding:12px 16px;color:var(--fg-3);font-size:12px;font-style:italic">暂无会话 · 按 N 新建</div>}
                  <button type="button" class="session-row new-session-row" data-action="new-session" data-workspace={workspace.id} aria-label="新建会话" title="新建会话"><Plus size={14} strokeWidth={1.75} aria-hidden="true" /></button>
                </div>
              </div>
            );
          })}
        </div>
        <aside class="tree" aria-label="工作区详情" hidden={treeHidden}>
          <div class="tree-head">
            <span class="tree-tabs"><button class="tree-tab on" type="button" data-action="show-file-tree"><Folder size={12} strokeWidth={1.75} aria-hidden="true" /> 文件</button><button class="tree-tab" type="button" data-action="show-git-history"><GitBranch size={12} strokeWidth={1.75} aria-hidden="true" /> Git</button></span>
            <span class="tree-head-actions"><button type="button" data-action="tree-root-menu" aria-label="文件树操作" title="文件树操作"><Plus size={12} strokeWidth={1.75} aria-hidden="true" /></button><button type="button" data-action="refresh-tree" aria-label="刷新工作区浏览器" title="刷新工作区浏览器"><RefreshCw size={12} strokeWidth={1.75} aria-hidden="true" /></button></span>
          </div>
          <div class="tree-list">
            <WorkspaceFileTree client:load initialFiles={fileTree} />
          </div>
          <div class="git-panel" data-git-panel hidden></div>
        </aside>
        <div class="sb-footer">
          <div class="sb-footer-status">
            <span class="status-dot"></span><span>连接中</span>
            <button class="sb-settings" type="button" data-action="open-settings" title="设置" aria-label="打开设置"><Settings size={14} strokeWidth={1.75} aria-hidden="true" /></button>
          </div>
        </div>
      </aside>
      <div class="sb-resizer" role="separator" aria-orientation="vertical" aria-label="调整侧栏大小" title="拖动以调整大小"></div>
    </div>

    <main class="main" data-main="session" hidden={sessionHidden}> 
      {showDisconnect && <div class="disconn"><span class="pulse"></span><span>连接已断开 · 2 秒后重试</span></div>}
      <div class:list={["term", scanlines && "scanlines"]}>
        <div class="term-inner">
          {conversation.length === 0 ? (
            <pre class="ascii-banner welcome-banner" data-welcome-banner set:html={renderBannerBody(PI_WEB_WELCOME_TEXT)}></pre>
          ) : conversation.map((msg) => (
            msg.kind === "banner" ? <pre class="ascii-banner" set:html={renderBannerBody(msg.text)}></pre> :
            msg.kind === "user" ? <div class="msg"><div class="prefix user">您 &gt;</div><div class="body markdown-body" set:html={renderUserBody(msg.text)}></div></div> :
            msg.kind === "think" ? <div class="msg"><div class="prefix think">—</div><div class="body" style="flex:1"><div class="thinking-block"><span class="label">thinking</span>{msg.text}</div></div></div> :
            msg.kind === "pi" ? <div class="msg"><div class="prefix pi">agent &gt;</div><div class="body markdown-body" set:html={renderPiBody(msg.text)}></div></div> :
            msg.kind === "tool" ? <div class="tool-card" data-tool={msg.tool} data-tool-call-id={msg.id || undefined} data-status={msg.status || ""}>
              <div class="tc-head">
                <span class="tc-glyph" set:html={toolIconHtml(msg)}></span><span class="tc-name">{msg.tool}</span><span class="tc-args">{formatToolArgs(msg.tool, msg.args)}</span><span class="tc-meta" set:html={toolStatus(msg)}></span>
              </div>
              <div class="tc-body" data-full-tool-body={isLargeToolBody(msg.body || "") ? msg.body : undefined} set:html={msg.body ? renderToolBody(msg.body) : ""}></div>
            </div> : null
          ))}
          <div class="compaction" hidden={compactionHidden}><span class="lbl">⚠ context summarized</span><span>older messages summarized · /undo to revert</span></div>
        </div>
        <div class="streaming-tail" data-streaming-tail></div>
      </div>
      <button type="button" class="scroll-bottom-btn" data-action="scroll-bottom" aria-label="scroll to bottom" title="scroll to bottom" hidden><ArrowDown size={14} strokeWidth={1.75} aria-hidden="true" /></button>
    </main>

    <main class="main" data-main="empty" hidden={emptyHidden}> 
      <div class="empty-shell"><div class="empty-inner"><div class="empty-title">在 <span class="accent" data-empty-workspace>{activeWorkspaceName}</span> 中新建会话</div><div class="empty-sub">pi 当前空闲，请说第一句话。</div><div class="empty-tips"><div class="dim">首次发送后将分配会话 ID。</div></div></div></div>
    </main>

    <div class="file-preview-panel" data-file-preview hidden>
      <div class="fp-resizer" role="separator" aria-orientation="vertical" aria-label="调整文件预览大小" aria-valuemin="320" aria-valuemax="720" aria-valuenow="560" title="拖动以调整大小"></div>
      <div class="fp-dialog" role="region" aria-labelledby="file-preview-title">
        <div class="fp-head">
          <div><strong id="file-preview-title" class="fp-path">文件</strong><small></small></div>
          <div class="fp-actions"><div class="fp-save-slot"><button type="button" data-action="save-file-preview" hidden>保存</button></div><div class="fp-mode-actions"><button type="button" data-action="toggle-file-preview-mode" hidden aria-label="切换文件预览模式">预览</button><button type="button" data-action="close-file-preview" aria-label="关闭文件预览"><X size={14} strokeWidth={1.75} aria-hidden="true" /></button></div></div>
        </div>
        <div class="fp-body"></div>
      </div>
    </div>
    <aside class="git-detail-panel" data-git-detail-panel aria-label="Git 提交详情" hidden>
      <div class="fp-resizer" role="separator" aria-orientation="vertical" aria-label="调整 Git 详情大小" aria-valuemin="320" aria-valuemax="720" aria-valuenow="560" title="拖动以调整大小"></div>
    </aside>
  <div class="prompt-region">
    <div class="slash-pop" hidden>
      <div class="slash-head">slash commands · type to filter</div>
      <div class="slash-list">{slashCommands.map((cmd, index) => {
        const command = cmd.command || cmd.cmd || `/${cmd.name}`;
        return <button type="button" class:list={["slash-item", index === 0 && "selected"]} data-slash={command}><span class="sl-cmd">{command}</span><span class="sl-tags"><span class="sl-scope">{cmd.scope || "global"}</span><span class="sl-source">{cmd.source || "command"}</span></span><span class="sl-desc">{cmd.description || cmd.desc}</span></button>;
      })}</div>
    </div>
    <div class="prompt-bar">
      <button class="attach-btn" type="button" aria-label="attach files" title="attach files"><Paperclip size={14} strokeWidth={1.5} aria-hidden="true" /></button>
      <input type="file" multiple hidden data-file-input />
      <div class="prompt-input-col"><div class="attach-chips" hidden></div><textarea class="prompt-textarea" placeholder="输入你的想法" rows="1"></textarea></div>
      <div class="prompt-actions"><button class="stop-btn" type="button" aria-label="stop" title="stop" hidden><Square size={13} strokeWidth={2} aria-hidden="true" /></button><button class="send-btn" type="button" aria-label="send" title="send" aria-disabled="true"><SendHorizontal size={14} strokeWidth={2} aria-hidden="true" /></button></div>
      <div class="drop-overlay" hidden><span>drop to attach</span></div>
    </div>
    <div class="prompt-meta"><span data-prompt-meta>— | <span class="prompt-meta-item prompt-meta-branch"><GitBranch size={12} strokeWidth={1.75} aria-hidden="true" /><span>—</span></span></span><button type="button" class="compact-btn" data-action="compact-session" disabled aria-label="压缩上下文" title="压缩上下文">压缩上下文</button></div>
  </div>

    <div class="scrim" data-action="close-drawer"></div>
  </section>



  <div class="admin-password-gate" data-admin-password-gate hidden>
    <form class="admin-password-dialog" data-admin-password-setup-form role="dialog" aria-modal="true" aria-labelledby="admin-password-title">
      <strong id="admin-password-title">设置管理员密码</strong>
      <p>首次使用 pi-web 前，必须设置管理员密码。</p>
      <label>管理员密码
        <input data-admin-password type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <label>确认密码
        <input data-admin-password-confirmation type="password" autocomplete="new-password" required minlength="8" />
      </label>
      <small data-admin-password-status aria-live="polite"></small>
      <button type="submit">设置并继续</button>
    </form>
  </div>

  <div class="settings-modal" data-settings-modal hidden>
    <form class="settings-dialog" data-settings-form role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1">
      <div class="settings-head">
        <div><strong id="settings-title" data-i18n="settingsTitle">pi settings</strong><small data-i18n="settingsSubtitle">same files used by settings command</small></div>
        <button type="button" data-action="close-settings" aria-label="close settings" data-i18n-aria-label="closeSettings"><X size={14} strokeWidth={1.75} aria-hidden="true" /></button>
      </div>
      <div class="settings-body">
        <div class="settings-language-row">
          <label><span data-i18n="language">Language</span>
            <select name="uiLanguage" data-ui-language>
              {UI_LOCALES.map((locale) => <option value={locale.code}>{locale.label}</option>)}
            </select>
          </label>
          <small data-i18n="languageHint">Changes apply immediately and are saved on this device.</small>
        </div>
        <div class="settings-toolbar">
          <label><span data-i18n="scope">scope</span>
            <select name="scope" data-settings-scope>
              <option value="project" data-i18n="project">project</option>
              <option value="global" data-i18n="global">global</option>
            </select>
          </label>
          <span data-settings-path>—</span>
        </div>
        <section class="app-settings-section" aria-labelledby="app-settings-title">
          <div class="app-settings-head">
            <div>
              <strong id="app-settings-title">pi-web 应用设置</strong>
              <small>用户级配置，不随 project / global scope 切换</small>
            </div>
            <small class="app-settings-path">path: <code data-app-config-path>—</code></small>
          </div>
          <label class="settings-field">
            <span>品牌</span>
            <input data-app-setting="brand" autocomplete="off" placeholder="pi.dev / web" />
          </label>
          <div class="allowed-roots-settings">
            <div class="allowed-roots-head">
              <div>
                <strong>工作区允许目录</strong>
                <small>限制工作区文件访问；不填写表示不限制。</small>
              </div>
              <button type="button" data-allowed-root-add aria-haspopup="dialog" aria-expanded="false">添加目录</button>
            </div>
            <textarea data-app-setting="allowed-roots" hidden aria-hidden="true"></textarea>
            <div class="allowed-roots-list" data-allowed-roots-list></div>
            <small class="allowed-roots-hint" data-allowed-roots-hint>不限制工作区目录</small>
          </div>
        </section>
        <details class="auth-login" data-auth-form>
          <summary>
            <span class="auth-login-title"><span data-i18n="authTitle">Authentication</span> <em data-i18n="authMode">API key login</em></span>
            <small data-auth-status>API key is stored in ~/.pi/agent/auth.json</small>
          </summary>
          <div class="auth-login-fields">
            <label><span data-i18n="provider">provider</span>
              <select data-auth-provider>
                <option value="">loading providers…</option>
              </select>
            </label>
            <label><span data-i18n="apiKey">API key</span>
              <input data-auth-api-key type="password" autocomplete="off" placeholder="paste API key" data-i18n-placeholder="pasteApiKey" />
            </label>
            <div class="auth-login-actions">
              <button type="button" data-action="save-auth-provider" data-i18n="saveKey">save key</button>
              <button type="button" data-action="logout-auth-provider" data-i18n="logout">logout</button>
            </div>
          </div>
          <div class="oauth-login-fields" data-oauth-fields hidden>
            <label><span data-i18n="oauthProvider">OAuth provider</span>
              <select data-oauth-provider>
                <option value="" data-i18n="loadingOAuthProviders">loading OAuth providers…</option>
              </select>
            </label>
            <button type="button" data-action="start-oauth-login" data-i18n="loginWithOAuth">login with OAuth</button>
            <a data-oauth-link href="#" target="_blank" rel="noreferrer" hidden data-i18n="openLoginPage">open login page</a>
            <input data-oauth-input autocomplete="off" placeholder="prompt input or redirect URL" data-i18n-placeholder="oauthInput" hidden />
            <button type="button" data-action="send-oauth-input" hidden data-i18n="send">send</button>
            <small data-oauth-status>OAuth supports Claude, Codex, and Copilot subscriptions.</small>
          </div>
        </details>
        <div class="settings-groups">
          {settingsGroups.map((group) => (
            <section class="settings-group">
              <div class="settings-group-head">
                <div>
                  <strong data-i18n={group.titleKey}>{group.title}</strong>
                  <small data-i18n={group.descriptionKey}>{group.description}</small>
                </div>
              </div>
              <div class="settings-grid">
                {group.fields.map((field) => (
                  <label
                    class="settings-field"
                  >
                    <span>{field.label}</span>
                      {field.type === "text" ? (
                      <input data-setting={field.path} autocomplete="off" placeholder={field.hint} />
                    ) : field.type === "password" ? (
                      <input data-setting={field.path} type="password" autocomplete="off" placeholder={field.hint} />
                    ) : field.type === "providerSelect" || field.type === "modelSelect" ? (
                      <>
                        <select data-setting={field.path} disabled>
                          <option value="inherit">loading models…</option>
                        </select>
                        <input data-custom-setting={field.path} autocomplete="off" placeholder={`custom ${field.label}`} hidden />
                      </>
                    ) : field.type === "boolean" ? (
                      <select data-setting={field.path}>
                        <option value="inherit">inherit</option>
                        <option value="true">on</option>
                        <option value="false">off</option>
                      </select>
                    ) : field.type === "checkbox" ? (
                      <span class="settings-checkbox"><input type="checkbox" data-setting={field.path} /> <span data-i18n="enabled">Enabled</span></span>
                    ) : (
                      <select data-setting={field.path}>
                        <option value="inherit">inherit</option>
                        {field.values.map((value) => <option value={value}>{value}</option>)}
                      </select>
                    )}
                    <small>effective: not set</small>
                  </label>
                ))}
              </div>
            </section>
          ))}
        </div>

      </div>
      <div class="settings-foot">
        <span data-settings-status>blank fields inherit from effective settings</span>
        <button type="button" data-action="close-settings" data-i18n="cancel">cancel</button>
        <button type="submit" data-i18n="save">save</button>
      </div>
    </form>
  </div>

  <div class="twk-panel" data-tweaks hidden><div class="twk-hd"><b>调整项</b><button class="twk-x" type="button" data-action="close-tweaks" aria-label="关闭调整项"><X size={14} strokeWidth={1.75} aria-hidden="true" /></button></div><div class="twk-body"><div class="twk-sect">布局</div><button class="twk-btn secondary" type="button" data-action="route-picker">工作区选择器</button><button class="twk-btn secondary" type="button" data-action="route-workspace">会话视图</button><button class="twk-btn secondary" type="button" data-action="new-session">新建会话</button></div></div>
</pi-app>

<script>
  import "./pi-app/index";
</script>
